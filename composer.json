{
    "name": "kavezoo/kvadmin",
    "description": "KvAdmin for Cakephp 5.4.* projects. Based on Tabler Admin Template",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
			"KvAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
			"KvAdmin\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true
        }
    }
}

