{% set belongsTo = Bake.aliasExtractor(modelObj, 'BelongsTo') %}
{% set belongsToMany = Bake.aliasExtractor(modelObj, 'belongsToMany') %}
{% set compact = ["'#{singularName}'"] %}
{% set pkField = primaryKey[0] ?? 'id' %}
    /**
     * Edit method
     *
     * @param string|null $id {{ singularHumanName }} id.
     * @return \Cake\Http\Response|null|void Redirects on successful edit, renders view otherwise.
     * @throws \Cake\Datasource\Exception\RecordNotFoundException When record not found.
     */
    public function edit($id = null)
    {
        ${{ singularName }} = $this->fetchTable('{{ currentModelName }}')->get($id, contain: {{ Bake.exportArray(belongsToMany)|raw }});
{% if Bake.hasPlugin('Authorization') %}
        $this->Authorization->authorize(${{ singularName }});
{% endif %}
		$this->session->write('LastViewed.{{ prefix|replace({'\\': ''}) }}.{{ singularName }}_id', (int)$id ?? 0);
		$this->session->write('ScrollTo.{{ prefix|replace({'\\': ''}) }}.{{ singularName }}_id', (int)$id ?? 0);

        if ($this->getRequest()->is(['patch', 'post', 'put'])) {
            $data = $this->getRequest()->getData();
            ${{ singularName }} = $this->fetchTable('{{ currentModelName }}')->patchEntity(${{ singularName }}, $data);
            if ($this->fetchTable('{{ currentModelName }}')->save(${{ singularName }})) {
                $this->Flash->success({% if plugin %}__d('{{ plugin }}', {% else %}__({% endif %}'The {0} has been saved.', __('{{ singularHumanName|lower }}')), ['plugin' => 'KvAdmin']);

                $redirectParams = (array)$this->session->read('Paging.{{ prefix|replace({'\\': ''}) }}.{{ currentModelName }}.params');
                return $this->redirect([
                    'action' => 'index',
                    '?' => $redirectParams,
                ]);
            }
            $this->Flash->error({% if plugin %}__d('{{ plugin }}', {% else %}__({% endif %}'Could not save data. Please review the errors and try again.'), ['plugin' => 'KvAdmin']);
        }
{% for assoc in belongsTo|merge(belongsToMany) %}
    {%~ set otherName = Bake.getAssociatedTableAlias(modelObj, assoc) %}
    {%~ set otherPlural = otherName|variable %}
    {%~ if otherPlural == singularName %}
        {%~ set otherPlural = otherPlural ~ 'List' %}
    {%~ endif %}
        ${{ otherPlural }} = $this->fetchTable('{{ currentModelName }}')->{{ otherName }}->find('list', limit: 200)->all();
    {%~ set compact = compact|merge(["'#{otherPlural}'"]) %}
{% endfor %}
        $this->set(compact({{ compact|join(', ')|raw }}));
    }