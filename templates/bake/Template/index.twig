<?php
/**
 * @var \App\View\AppView $this
 * @var iterable<\App\Model\Entity\{{ singularName }}> ${{ pluralVar }}
 * @var int|null $lastViewedId
 * @var int|null $scrollToId
 * @var string|null $search
 * @var array<string, mixed>|null $parentContext
 */
use Cake\I18n\I18n;

$showId            = false;
$showCounterFields = false;
$showVisible       = true;
$showCreated       = false;
$showModified      = false;
$showPos           = false;

$this->assign('title', __('{{ pluralVar|capitalize }}'));
$this->element('KvAdmin.pagination_templates');

$lastViewedId = $lastViewedId ?? $session->read('LastViewed.' . $prefix . '.{{ singularVar }}_id');
$scrollToId = $scrollToId ?? $session->read('ScrollTo.' . $prefix . '.{{ singularVar }}_id') ?? $lastViewedId;

// 🔍 Keresési kiemelő segédfüggvény
$highlight = function (?string $text) use ($search): string {
    if ($text === null || $text === '') {
        return '';
    }

    $escapedText = h($text);
    if (!empty($search)) {
        $cleanSearch = preg_quote(trim($search), '/');
        return preg_replace('/(' . $cleanSearch . ')/iu', '<mark class="search-highlight">$1</mark>', $escapedText);
    }
    return $escapedText;
};
?>
{% set fields = Bake.filterFields(fields, schema, modelObject, indexColumns, ['binary', 'text']) %}
{% set pk = '$' ~ singularVar ~ '->' ~ primaryKey[0] %}
{% set associations = {'BelongsTo': [], 'HasOne': [], 'HasMany': [], 'BelongsToMany': []}|merge(associations|default({})) %}
{% set childAssociations = associations.HasMany|default({}) %}

<div class="card">
    <?php if (!empty($parentContext)): ?>
