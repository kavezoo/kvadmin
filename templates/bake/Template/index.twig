<?php endif; ?>
{% elseif field in ['created', 'modified'] %}
{% if not timestampRendered %}
{% set timestampRendered = true %}
<?php if ((isset($showCreated) && $showCreated) || (isset($showModified) && $showModified)): ?>
                    <th class="datetime">
<?php if (isset($showCreated) && $showCreated): ?>
