                <tr
                    id="row-<?= (int){{ pk|raw }} ?>"
                    class="<?= $isLastViewed ? 'last-viewed' : '' ?>"
                    data-edit-url="<?= $this->Url->build(['action' => 'edit', {{ pk|raw }}]) ?>"
                >
{% set timestampBodyRendered = false %}
{% for field in fields %}
{% set columnData = Bake.columnData(field, schema) %}
{% if field == primaryKey[0] %}
<?php if (isset($showId) && $showId): ?>
                    <td class="{{ columnData.type }} {{ field }}"><?= h({{ pk|raw }}) ?></td>
<?php endif; ?>
{% elseif field ends with '_count' %}
<?php if (isset($showCounterFields) && $showCounterFields): ?>
                    <td class="{{ columnData.type }} {{ field }} text-end"><?= $this->Number->format(${{ singularVar }}->{{ field }}) ?></td>
<?php endif; ?>
{% elseif field == 'pos' %}
<?php if (isset($showPos) && $showPos): ?>
                    <td class="{{ columnData.type }} {{ field }}"><?= h(${{ singularVar }}->pos) ?></td>
<?php endif; ?>
{% elseif field == 'visible' %}
<?php if (isset($showVisible) && $showVisible): ?>
                    <td class="{{ columnData.type }} {{ field }}"><?= ${{ singularVar }}->visible ? '<span class="badge bg-green-lt">' . __('Igen') . '</span>' : '<span class="badge bg-secondary-lt">' . __('Nem') . '</span>' ?></td>
