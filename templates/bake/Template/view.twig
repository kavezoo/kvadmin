<?php
/**
 * @var \{{ namespace }}\View\AppView $this
 * @var \{{ entityClass }} ${{ singularVar }}
 */
?>
{% set associations = {'BelongsTo': [], 'HasOne': [], 'HasMany': [], 'BelongsToMany': []}|merge(associations) %}
{% set fieldsData = Bake.getViewFieldsData(fields, schema, associations) %}
{% set associationFields = fieldsData.associationFields %}
{% set groupedFields = fieldsData.groupedFields %}
{% set pK = '$' ~ singularVar ~ '->' ~ primaryKey[0] %}
<div class="page-header d-print-none mb-3 {{ pluralVar }}">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title"><?= __('{0} megtekintése', __('{{ singularHumanName }}')) ?></h2>
        </div>
        <div class="col-auto ms-auto">
            <?= $this->KvForm->linkCloseIndex() ?>
        </div>
    </div>
</div>

<div class="card mb-3 {{ pluralVar }}">
    <div class="card-header pe-3">
        <div class="row w-full align-items-center gy-2 gy-md-0">
            <div class="col">
                <h3 class="card-title mb-0"><?= h(${{ singularVar }}->{{ displayField }}) ?></h3>
            </div>
            <div class="col-12 col-md-auto ms-md-auto">
                <div class="btn-list">
                    <?= $this->KvForm->actionEdit(['action' => 'edit', {{ pK|raw }}]) ?>
                    <?= $this->KvForm->actionDelete(['action' => 'delete', {{ pK|raw }}], (string)(${{ singularVar }}->{{ displayField }} ?? '')) ?>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-sm table-bordered-vertical">
            <tbody>
{% if groupedFields['string'] %}
    {%~ for field in groupedFields['string'] %}
        {%~ if associationFields[field] is defined %}
            {%~ set details = associationFields[field] %}
                <tr>
                    <th class="w-1 text-nowrap"><?= {% if useDomain %}__d('{{ plugin }}', {% else %}__({% endif %}'{{ details.property|humanize }}') ?></th>
                    <td><?= $this->KvForm->linkRelatedRecord(${{ singularVar }}, '{{ details.property }}', '{{ details.displayField }}', '{{ details.controller }}', '{{ details.primaryKey[0] }}') ?></td>
                </tr>
        {%~ else %}
                <tr>
                    <th class="w-1 text-nowrap"><?= {% if useDomain %}__d('{{ plugin }}', {% else %}__({% endif %}'{{ field|humanize }}') ?></th>
                    <td><?= h(${{ singularVar }}->{{ field }}) ?></td>
                </tr>
        {%~ endif %}
    {%~ endfor %}
{% endif %}
{% if associations.HasOne %}
    {%~ for alias, details in associations.HasOne %}
                <tr>
                    <th class="w-1 text-nowrap"><?= {% if useDomain %}__d('{{ plugin }}', {% else %}__({% endif %}'{{ alias|underscore|singularize|humanize }}') ?></th>
                    <td><?= $this->KvForm->linkRelatedRecord(${{ singularVar }}, '{{ details.property }}', '{{ details.displayField }}', '{{ details.controller }}', '{{ details.primaryKey[0] }}') ?></td>
                </tr>
    {%~ endfor %}
{% endif %}
{% if groupedFields.number %}
    {%~ for field in groupedFields.number %}
                <tr>
                    <th class="w-1 text-nowrap"><?= {% if useDomain %}__d('{{ plugin }}', {% else %}__({% endif %}'{{ field|humanize }}') ?></th>
{% set columnData = Bake.columnData(field, schema) %}
{% if columnData.null %}
                    <td><?= ${{ singularVar }}->{{ field }} === null ? '' : $this->Number->format(${{ singularVar }}->{{ field }}) ?></td>
{% else %}
                    <td><?= $this->Number->format(${{ singularVar }}->{{ field }}) ?></td>
{% endif %}
                </tr>
    {%~ endfor %}
{% endif %}
{% if groupedFields.enum %}
    {%~ for field in groupedFields.enum %}
                <tr>
                    <th class="w-1 text-nowrap"><?= {% if useDomain %}__d('{{ plugin }}', {% else %}__({% endif %}'{{ field|humanize }}') ?></th>
{% set columnData = Bake.columnData(field, schema) %}
{% set supportsLabel = Bake.enumSupportsLabel(field, schema) %}
{% if columnData.null %}
                    <td><?= ${{ singularVar }}->{{ field }} === null ? '' : h(${{ singularVar }}->{{ field }}->{% if supportsLabel %}label(){% else %}value{% endif %}) ?></td>
{% else %}
                    <td><?= h(${{ singularVar }}->{{ field }}->{% if supportsLabel %}label(){% else %}value{% endif %}) ?></td>
{% endif %}
                </tr>
    {%~ endfor %}
{% endif %}
{% if groupedFields.date %}
    {%~ for field in groupedFields.date %}
                <tr>
                    <th class="w-1 text-nowrap"><?= {% if useDomain %}__d('{{ plugin }}', {% else %}__({% endif %}'{{ field|humanize }}') ?></th>
                    <td><?= h(${{ singularVar }}->{{ field }}) ?></td>
                </tr>
    {%~ endfor %}
{% endif %}
{% if groupedFields.boolean %}
    {%~ for field in groupedFields.boolean %}
                <tr>
                    <th class="w-1 text-nowrap"><?= {% if useDomain %}__d('{{ plugin }}', {% else %}__({% endif %}'{{ field|humanize }}') ?></th>
                    <td><?= ${{ singularVar }}->{{ field }} ? '<span class=\"badge bg-green-lt\">' . __('Igen') . '</span>' : '<span class=\"badge bg-secondary-lt\">' . __('Nem') . '</span>' ?></td>
                </tr>
    {%~ endfor %}
{% endif %}
            </tbody>
        </table>
    </div>
{% if groupedFields.text %}
    <div class="card-body">
    {%~ for field in groupedFields.text %}
        <div class="mb-3">
            <h4 class="m-0 mb-2"><?= {% if useDomain %}__d('{{ plugin }}', {% else %}__({% endif %}'{{ field|humanize }}') ?></h4>
            <div class="text-secondary"><?= $this->Text->autoParagraph(h(${{ singularVar }}->{{ field }})); ?></div>
        </div>
    {%~ endfor %}
    </div>
{% endif %}
</div>

{% set relations = associations.BelongsToMany|merge(associations.HasMany) %}
{% if relations %}
<?php
$hasRelatedRecords = false;
?>
{% for alias, details in relations %}
<?php if (!empty(${{ singularVar }}->{{ details.property }})) { $hasRelatedRecords = true; } ?>
{% endfor %}
<?php if ($hasRelatedRecords): ?>
<div class="card">
    <div class="card-header">
        <?php $isFirstRelatedTab = true; ?>
        <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs" role="tablist">
{% for alias, details in relations %}
{% set tabId = 'related-' ~ details.property %}
            <?php if (!empty(${{ singularVar }}->{{ details.property }})): ?>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link<?= $isFirstRelatedTab ? ' active' : '' ?>"
                    data-bs-toggle="tab"
                    data-bs-target="#{{ tabId }}"
                    type="button"
                    role="tab"
                >
                    <?= __('{{ alias|underscore|humanize }}') ?>
                </button>
            </li>
            <?php $isFirstRelatedTab = false; ?>
            <?php endif; ?>
{% endfor %}
        </ul>
    </div>
    <div class="card-body tab-content">
        <?php $isFirstRelatedPane = true; ?>
{% for alias, details in relations %}
{% set otherSingularVar = alias|singularize|variable %}
{% if otherSingularVar == singularVar %}
    {% set otherSingularVar = otherSingularVar ~ 'Related' %}
{% endif %}
{% set otherPk = '$' ~ otherSingularVar ~ '->' ~ details.primaryKey[0] %}
{% set tabId = 'related-' ~ details.property %}
        <?php if (!empty(${{ singularVar }}->{{ details.property }})): ?>
        <div class="tab-pane<?= $isFirstRelatedPane ? ' active show' : '' ?>" id="{{ tabId }}" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover table-sm table-bordered-vertical">
                    <thead>
                        <tr>
{% for field in details.fields %}
{% if details.foreignKey is defined and field != details.foreignKey %}
                            <th><?= __('{{ field|humanize }}') ?></th>
{% elseif details.foreignKey is not defined %}
                            <th><?= __('{{ field|humanize }}') ?></th>
{% endif %}
{% endfor %}
                            <th class="actions w-1"><?= __('Actions') ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach (${{ singularVar }}->{{ details.property }} as ${{ otherSingularVar }}): ?>
                        <tr data-edit-url="<?= $this->Url->build(['controller' => '{{ details.controller }}', 'action' => 'edit', {{ otherPk|raw }}]) ?>">
{% for field in details.fields %}
{% if details.foreignKey is defined and field != details.foreignKey %}
                            <td><?= h(${{ otherSingularVar }}->{{ field }}) ?></td>
{% elseif details.foreignKey is not defined %}
                            <td><?= h(${{ otherSingularVar }}->{{ field }}) ?></td>
{% endif %}
{% endfor %}
                            <td class="actions">
                                <div class="btn-list flex-nowrap align-items-center">
                                    <?= $this->KvForm->actionView(['controller' => '{{ details.controller }}', 'action' => 'view', {{ otherPk|raw }}], ['title' => __('View')]) ?>
                                    <?= $this->KvForm->actionEdit(['controller' => '{{ details.controller }}', 'action' => 'edit', {{ otherPk|raw }}], ['title' => __('Edit')]) ?>
                                    <?= $this->KvForm->actionDelete(['controller' => '{{ details.controller }}', 'action' => 'delete', {{ otherPk|raw }}], (string)({{ otherPk|raw }})) ?>
                                </div>
                            </td>
                        </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        </div>
        <?php $isFirstRelatedPane = false; ?>
        <?php endif; ?>
{% endfor %}
    </div>
</div>
<?php endif; ?>
{% endif %}

<?= $this->element('KvAdmin.modal-delete') ?>

<?php
// --- Dupla kattintás a kapcsolt rekordok során: ugrás szerkesztésre ---
$this->Html->scriptBlock(<<<'JS'
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.table tbody tr[data-edit-url]').forEach(function (row) {
        row.addEventListener('dblclick', function (e) {
            if (e.target.closest('a, button, input, select, textarea, label, .actions')) {
                return;
            }

            const editUrl = row.getAttribute('data-edit-url');
            if (editUrl) {
                window.location.href = editUrl;
            }
        });
    });
});
JS, ['block' => 'footer']);
?>